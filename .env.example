# Configuración de Tracción Digital Video Agent
BRAND_NAME=Tracción Digital
BRAND_WEBSITE=tracciondigital.com.mx
WHATSAPP_CONTACT=+52 296 162 2434

# Voz (Gratuita con Edge-TTS)
# Opciones recomendadas: es-MX-DaliaNeural (femenina, dulce y clara), es-MX-CarlotaNeural
VOICE_NAME=es-MX-DaliaNeural

# Reglas de Contenido
FORBIDDEN_KEYWORDS=costo,costos,precio,precios,cotización barata,cuánto cuesta,pesos,dólares,$

# Horarios de Producción
MORNING_SCHEDULE_TIME=08:30
EVENING_SCHEDULE_TIME=18:30

# APIs Opcionales / Gratuitas (Pexels para B-roll tech)
PEXELS_API_KEY=
